+    std::string screen_name(Engine& engine) {
+        auto screen = engine.getScreen();
+        return screen ? screen->getName() : "";
+    }
+
+    dv::value cmd_step(Engine& engine, const dv::value& args) {
+        if (state.realtime) {
+            // frames run on the wall clock by themselves
+            throw std::runtime_error("clock-realtime");
+        }
+        int64_t ticks = args.has("ticks") ? args["ticks"].asInteger() : 1;
+        int64_t frames = args.has("frames") ? args["frames"].asInteger() : 1;
+        double partial = args.has("partial") ? args["partial"].asNumber() : 0.0;
+        if (ticks < 0 || frames < 0) {
+            throw std::runtime_error("ticks and frames must be >= 0");
+        }
+        auto& window = engine.getWindow();
+        auto& input = engine.getInput();
+        auto& time = engine.getTime();
+
+        const double total = (static_cast<double>(ticks) + partial) * 0.05;
+        const int64_t passes = std::max<int64_t>(frames, 1);
+        const double base = state.clock;
+        for (int64_t i = 0; i < passes; i++) {
+            // exact virtual clock: no accumulation of per-frame rounding
+            double next = base + total * static_cast<double>(i + 1) /
+                                     static_cast<double>(passes);
+            perf::frame_begin(state.frames, state.ticks, next);
+            {
+                F2F_PERF_SCOPE(INPUT);
+                input.pollEvents(false);
+            }
+            time.step(next - state.clock);
+            state.clock = next;
+            {
+                F2F_PERF_SCOPE(APP_TICK);
+                engine.applicationTick();
+            }
+            {
+                F2F_PERF_SCOPE(UPDATE);
+                engine.updateFrontend();
+            }
+            if (frames > 0) {
+                F2F_PERF_SCOPE(RENDER);
+                engine.renderFrame();
+            }
+            {
+                F2F_PERF_SCOPE(POST_UPDATE);
+                engine.postUpdate();
+            }
+            if (frames > 0) {
+                {
+                    F2F_PERF_SCOPE(PRESENT);
+                    window.swapBuffers();
+                }
+                state.frames++;
+            }
+            perf::frame_end();
+            if (engine.isQuitSignal() || window.isShouldClose()) {
+                break;
+            }
+        }
+        state.ticks += ticks;
+        return dv::object({
+            {"tick", state.ticks},
+            {"frame", state.frames},
+            {"time", state.clock},
+            {"screen", screen_name(engine)},
+        });
+    }
+
+    dv::value cmd_shot(Engine& engine, const dv::value& args) {
+        auto& window = engine.getWindow();
+        // reads the offscreen framebuffer (default fb binding is redirected);
+        // rows are bottom-up as from glReadPixels: since 0.32 (279fb92b
+        // "fix canvas:encode produces flipped images for png")
+        // imageio::encode -> png::encode_image writes them bottom-up itself,
+        // so no flipY here (0.31 needed it). Same path as gui.screenshot()
+        // + Canvas:encode("png").
+        auto image = window.takeScreenshot();
+        auto buffer = imageio::encode(imageio::ImageFileFormat::PNG, *image);
+        std::string sha = sha256_hex(buffer.data(), buffer.size());
+        dv::value result = dv::object({
+            {"w", static_cast<int64_t>(image->getWidth())},
+            {"h", static_cast<int64_t>(image->getHeight())},
+            {"sha256", sha},
+            {"bytes", static_cast<int64_t>(buffer.size())},
+        });
+        if (args.has("path")) {
+            std::string path = args["path"].asString();
+            std::ofstream file(path, std::ios::binary);
+            if (!file) {
+                throw std::runtime_error("could not open " + path);
+            }
+            file.write(
+                reinterpret_cast<const char*>(buffer.data()), buffer.size()
+            );
+            file.close();
+            result["path"] = path;
+        }
+        return result;
+    }
