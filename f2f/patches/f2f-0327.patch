+void f2f::configure(
+    int port, int width, int height, bool realtime, bool hidden
+) {
+    state.active = true;
+    state.realtime = realtime;
+    state.hidden = hidden;
+    state.port = port;
+    state.size = {width, height};
+    render::gates_active = true;
+    logger.info() << "F2F mode: port " << port << ", frame " << width << "x"
+                  << height << ", clock " << (realtime ? "realtime" : "virtual")
+                  << ", window " << (hidden ? "hidden" : "normal")
+                  << ", input isolated";
+}
