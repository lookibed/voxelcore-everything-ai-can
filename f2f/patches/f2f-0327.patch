+    /// `selftest {throw:bool}`: strings that are not valid UTF-8 placed into a
+    /// response on purpose (cp1251 "Ошибка", a broken sequence, control
+    /// characters). The response must still be one valid JSON line; with
+    /// throw:true the same bytes go through the error path (as an exception
+    /// from the OS with an ANSI message would).
+    dv::value cmd_selftest(const dv::value& args) {
+        const std::string cp1251 = "\xCE\xF8\xE8\xE1\xEA\xE0";  // "Ошибка"
+        const std::string mixed = std::string("path/\xD0\x9F\xD1\x83\xD1\x82\xD1\x8C/") +
+                                  cp1251 + " end";  // UTF-8 "Путь" + cp1251
+        const std::string broken = "abc\xE2\x82";      // truncated euro sign
+        const std::string control = "a\x01" "b\x1F" "c\td";
+        const std::string emoji = "\xF0\x9F\x98\x80";  // U+1F600, valid
+        if (args.has("throw") && args["throw"].asBoolean()) {
+            throw std::runtime_error("selftest: " + cp1251 + " [" + mixed + "]");
+        }
+        return dv::object({
+            {"cp1251", cp1251},
+            {"mixed", mixed},
+            {"broken", broken},
+            {"control", control},
+            {"emoji", emoji},
+            // object keys are written as \uXXXX: non-BMP -> U+FFFD
+            {"keys", dv::object({{cp1251 + emoji, static_cast<int64_t>(1)}})},
+            {"ansi_code_page", static_cast<int64_t>(text::ansi_code_page())},
+            {"valid", dv::object({
+                {"cp1251", text::is_valid_utf8(cp1251)},
+                {"emoji", text::is_valid_utf8(emoji)},
+            })},
+        });
+    }
+
+    /// mode flags for the lab daemon: the clock, input isolation (always
+    /// under --f2f: GLFW input callbacks are not installed, see
+    /// GLFWWindow.cpp setup_callbacks) and the window mode
+    dv::value mode_flags() {
+        return dv::object({
+            {"clock", std::string(state.realtime ? "realtime" : "virtual")},
+            {"input", std::string("isolated")},
+            {"window", std::string(state.hidden ? "hidden" : "normal")},
+        });
+    }
+
+    dv::value handle(Engine& engine, const std::string& cmd, const dv::value& args) {
+        if (cmd == "hello") {
+            return dv::object({
+                {"impl", std::string("vc")},
+                {"version", std::string(F2F_ENGINE_RELEASE) + "-f2f"},
+                {"w", static_cast<int64_t>(state.size.x)},
+                {"h", static_cast<int64_t>(state.size.y)},
+                {"tick_ms", 50},
+                {"fixed", !state.realtime},
+                {"flags", mode_flags()},
+                {"time", engine.getWindow().time()},
+                {"tick", state.ticks},
+                {"frame", state.frames},
+                {"screen", screen_name(engine)},
+                {"handler", static_cast<bool>(state.handler)},
+                {"layers", devtools::f2f::render::names()},
+                {"render", devtools::f2f::render::state()},
+                {"gl", gl_info()},
+                {"build", build_info()},
+                {"time_epoch", static_cast<int64_t>(state.timeEpoch)},
+            });
+        } else if (cmd == "render") {
+            return devtools::f2f::render::command(args);
+        } else if (cmd == "perf") {
+            return perf::command_perf(args);
+        } else if (cmd == "selftest") {
+            return cmd_selftest(args);
+        } else if (cmd == "mode") {
+            // render-time accumulators (u_timer, precipitation, texture
+            // animations) are reset by their owners on the next frame
+            state.timeEpoch++;
+            if (args.has("seed")) {
+                state.seed = args["seed"].asInteger();
+                std::srand(static_cast<unsigned>(state.seed));
+                devtools::f2f::seed_lua_random(state.seed);
+            }
+            dv::value result = dv::object({
+                {"fixed", !state.realtime},
+                {"seed", state.seed},
+                {"time_epoch", static_cast<int64_t>(state.timeEpoch)},
+                {"handler", static_cast<bool>(state.handler)},
+            });
+            if (state.handler) {
+                result["lua"] = call_handler(cmd, args);
+            }
+            return result;
+        } else if (cmd == "step") {
+            return cmd_step(engine, args);
+        } else if (cmd == "input") {
+            auto result = cmd_input(args);
+            // realtime: the next frame must not sleep in glfwWaitEventsTimeout
+            // (adaptive menu fps); events are applied by its pollEvents
+            engine.getWindow().setShouldRefresh();
+            return result;
+        } else if (cmd == "shot") {
+            return cmd_shot(engine, args);
+        } else if (cmd == "quit") {
+            state.quit = true;
+            return dv::object({{"quit", true}});
+        } else if (state.handler) {
+            return call_handler(cmd, args);
+        }
+        throw std::runtime_error("unknown-command");
+    }
+}
+
+namespace {
+    /// handle protocol lines that arrived within timeoutMs (main thread)
+    void process_commands(Engine& engine, f2f::LineServer& server, int timeoutMs) {
+        for (const auto& line : server.poll(timeoutMs)) {
+            dv::value response = dv::object();
+            dv::value id = nullptr;
+            std::string cmd;
+            int64_t t0 = perf::enabled() ? perf::now_us() : 0;
+            try {
+                auto request = json::parse(line);
+                if (request.has("id")) {
+                    id = request["id"];
+                }
+                cmd = request["cmd"].asString();
+                dv::value args =
+                    request.has("args") ? request["args"] : dv::object();
+                auto result = handle(engine, cmd, args);
+                response["id"] = id;
+                response["ok"] = true;
+                response["result"] = result;
+            } catch (const std::exception& err) {
+                // what() may be in the ANSI code page (filesystem_error):
+                // sanitised here and again in stringify_response
+                response = dv::object();
+                response["id"] = id;
+                response["ok"] = false;
+                response["error"] = text::sanitize(std::string_view(err.what()));
+                response["where"] = text::sanitize(cmd);
+            }
+            if (perf::enabled()) {
+                perf::command(cmd, t0 ? t0 : perf::now_us(), perf::now_us(), id);
+            }
+            server.send(text::stringify_response(response));
+            if (state.quit) {
+                break;
+            }
+        }
+    }
+
+    /// `--f2f-clock realtime`: the stock main loop (Mainloop::run +
+    /// WindowControl::nextFrame) with protocol commands between frames.
+    /// Same frame pacing as a user session: time from glfwGetTime, the
+    /// framerate/vsync settings are honoured by GLFWWindow::swapBuffers and
+    /// setFramerate, adaptive menu fps waits in pollEvents. Differences from
+    /// stock: the frame goes to the offscreen FBO and is blitted to the window
+    /// (present), the window is never iconified/unfocused for the engine, and
+    /// input comes only from the `input` command.
+    void run_realtime(Engine& engine, f2f::LineServer& server) {
+        auto& window = engine.getWindow();
+        auto& input = engine.getInput();
+        auto& time = engine.getTime();
+        const auto& settings = engine.getSettings();
+        while (!state.quit && !window.isShouldClose() &&
+               !engine.isQuitSignal()) {
+            double now = window.time();
+            perf::frame_begin(state.frames, state.ticks, now);
+            time.update(now);
+            {
+                F2F_PERF_SCOPE(APP_TICK);
+                engine.applicationTick();
+            }
+            {
+                F2F_PERF_SCOPE(UPDATE);
+                engine.updateFrontend();
+            }
+            {
+                F2F_PERF_SCOPE(RENDER);
+                engine.renderFrame();
+            }
+            {
+                F2F_PERF_SCOPE(POST_UPDATE);
+                engine.postUpdate();
+            }
+            bool waitForRefresh =
+                settings.display.adaptiveFpsInMenu.get() &&
+                dynamic_cast<const MenuScreen*>(engine.getScreen().get()) !=
+                    nullptr;
+            {
+                // includes the framerate sleep / vsync wait, as in stock
+                F2F_PERF_SCOPE(PRESENT);
+                window.setFramerate(settings.display.framerate.get());
+                window.swapBuffers();
+            }
+            state.frames++;
+            {
+                F2F_PERF_SCOPE(INPUT);
+                input.pollEvents(waitForRefresh && !window.checkShouldRefresh());
+            }
+            perf::frame_end();
+            process_commands(engine, server, 0);
+        }
+    }
+}
+
+void f2f::run_loop(Engine& engine) {
+    auto& window = engine.getWindow();
+    LineServer server;
+    std::string error = server.open(state.port);
+    if (!error.empty()) {
+        logger.error() << error;
+        engine.quit();
+        return;
+    }
+    logger.info() << "listening on 127.0.0.1:" << state.port << " (clock "
+                  << (state.realtime ? "realtime" : "virtual") << ")";
+    perf::set_main_thread();
+
+    if (state.realtime) {
+        run_realtime(engine, server);
+    } else {
+        while (!state.quit && !window.isShouldClose() &&
+               !engine.isQuitSignal()) {
+            // keep the window responsive; input callbacks are not installed
+            glfwPollEvents();
+            process_commands(engine, server, 5);
+        }
+    }
+    state.handler = nullptr;
+    server.close();
+    engine.quit();
+}
diff --git a/src/devtools/f2f.hpp b/src/devtools/f2f.hpp
new file mode 100644
index 00000000..e13cc9cb
--- /dev/null
+++ b/src/devtools/f2f.hpp
@@ -0,0 +1,88 @@
+#pragma once
+
+// F2F (frame-to-frame) test automation mode.
+// Active only with the `--f2f <port>` command-line flag; otherwise every
+// function here is a no-op and the engine behaves exactly as without the patch.
+// See agents/F2F.md (AlphaMine) for the protocol.
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include <glm/vec2.hpp>
+
+#include "data/dv.hpp"
+
+class Engine;
+
+namespace devtools::f2f {
+    using Handler = std::function<dv::value(const std::vector<dv::value>&)>;
+
+    enum class EventType { KEY, MOUSE_BUTTON, CURSOR, SCROLL, CHAR };
+
+    struct InputEvent {
+        EventType type;
+        int code = 0;
+        bool pressed = false;
+        double x = 0.0;
+        double y = 0.0;
+    };
+
+    /// @brief Enable F2F mode (called once, before the window is created).
+    /// realtime: the main loop runs on the wall clock like the stock engine
+    /// (`--f2f-clock realtime`), otherwise frames advance only by `step`.
+    /// hidden: the window is never shown (`--f2f-window hidden`).
+    /// Input isolation is unconditional under --f2f (see GLFWWindow.cpp).
+    void configure(
+        int port, int width, int height, bool realtime = false,
+        bool hidden = false
+    );
+
+    bool is_active();
+
+    /// @brief `--f2f-clock realtime`: wall-clock main loop, `step` refused
+    bool is_realtime();
+
+    /// @brief `--f2f-window hidden`: the window is created invisible
+    bool is_hidden();
+
+    /// @brief Make the native window non-activating (a click on it never
+    /// takes focus from the user) and, if show, show it without activation.
+    /// Implemented in f2f_text.cpp (the Win32 unit).
+    void isolate_native_window(void* glfwWindow, bool show);
+
+    /// @brief Fixed frame size in F2F mode
+    glm::ivec2 get_size();
+
+    /// @brief Virtual clock (seconds), advanced only by `step`
+    /// (virtual clock only; realtime uses glfwGetTime)
+    double get_time();
+
+    /// @brief Create the offscreen framebuffer of fixed size and redirect
+    /// default framebuffer (0) bindings to it. Requires current GL context.
+    void init_gl();
+
+    /// @brief Blit offscreen frame to the window (for eyes only) and swap
+    void present();
+
+    /// @brief Input events queued by the `input` command, consumed by
+    /// Input::pollEvents
+    std::vector<InputEvent> take_input_events();
+
+    /// @brief F2F main loop: executes protocol commands between frames
+    void run_loop(Engine& engine);
+
+    /// @brief Lua handler for commands not implemented in C++
+    void set_handler(Handler handler);
+
+    // implemented in f2f_lua.cpp
+    void seed_lua_random(long long seed);
+
+    /// @brief main Lua state memory (KB, LUA_GCCOUNT), -1 without a state
+    long long lua_memory_kb();
+
+    /// @brief `mode` counter: render-time accumulators (WorldRenderer u_timer,
+    /// precipitation, texture animations) reset when it changes, so a frame
+    /// after `mode` depends only on world state and the virtual clock
+    int time_epoch();
+}
diff --git a/src/devtools/f2f_lua.cpp b/src/devtools/f2f_lua.cpp
new file mode 100644
index 00000000..8bf3d9d1
--- /dev/null
+++ b/src/devtools/f2f_lua.cpp
@@ -0,0 +1,100 @@
+// Lua bindings for F2F mode: library `f2f`
+//   f2f.is_active() -> bool
+//   f2f.set_handler(function(cmd, args) return result end) -> bool
+//   f2f.now_us() -> number: engine clock (us), the time base of F2F `perf`
+//   f2f.trace_active() -> bool: F2F `perf {start:true, trace:true}` is on
+//   f2f.trace_event(name, ph, [args], [ts_us], [dur_us]) -> bool
+//       ph: "B"/"E" (begin/end), "X" (complete: ts defaults to now; dur
+//       defaults to now - ts), "i" (instant), "C" (counter, numeric args);
+//       written to the "lua" track of the perf trace; false when tracing is off
+// Handler receives protocol commands not implemented in C++ (state, gui, ...).
+
+#include "f2f.hpp"
+#include "f2f_perf.hpp"
+#include "logic/scripting/lua/libs/api_lua.hpp"
+#include "logic/scripting/lua/lua_engine.hpp"
+
+static int l_is_active(lua::State* L) {
+    return lua::pushboolean(L, devtools::f2f::is_active());
+}
+
+static int l_set_handler(lua::State* L) {
+    if (!devtools::f2f::is_active()) {
+        return lua::pushboolean(L, false);
+    }
+    if (lua::isnoneornil(L, 1)) {
+        devtools::f2f::set_handler(nullptr);
+        return lua::pushboolean(L, true);
+    }
+    if (!lua::isfunction(L, 1)) {
+        throw std::runtime_error("function expected");
+    }
+    lua::pushvalue(L, 1);
+    devtools::f2f::set_handler(lua::create_lambda(L));
+    return lua::pushboolean(L, true);
+}
+
+static int l_now_us(lua::State* L) {
+    return lua::pushnumber(
+        L, static_cast<lua::Number>(devtools::f2f::perf::now_us())
+    );
+}
+
+static int l_trace_active(lua::State* L) {
+    return lua::pushboolean(L, devtools::f2f::perf::tracing());
+}
+
+static int l_trace_event(lua::State* L) {
+    namespace perf = devtools::f2f::perf;
+    if (!perf::tracing()) {
+        return lua::pushboolean(L, false);
+    }
+    int64_t now = perf::now_us();
+    std::string name = lua::require_string(L, 1);
+    std::string ph = lua::require_string(L, 2);
+    dv::value args = nullptr;
+    if (lua::istable(L, 3)) {
+        args = lua::tovalue(L, 3);
+    }
+    int64_t ts = lua::isnumber(L, 4)
+                     ? static_cast<int64_t>(lua::tonumber(L, 4))
+                     : now;
+    int64_t dur = lua::isnumber(L, 5)
+                      ? static_cast<int64_t>(lua::tonumber(L, 5))
+                      : now - ts;
+    if (ph.size() != 1) {
+        return lua::pushboolean(L, false);
+    }
+    return lua::pushboolean(L, perf::lua_event(name, ph[0], args, ts, dur));
+}
+
+const luaL_Reg f2flib[] = {
+    {"is_active", lua::wrap<l_is_active>},
+    {"set_handler", lua::wrap<l_set_handler>},
+    {"now_us", lua::wrap<l_now_us>},
+    {"trace_active", lua::wrap<l_trace_active>},
+    {"trace_event", lua::wrap<l_trace_event>},
+    {nullptr, nullptr}
+};
+
+void devtools::f2f::seed_lua_random(long long seed) {
+    auto L = lua::get_main_state();
+    if (L == nullptr) {
+        return;
+    }
+    lua_getglobal(L, "math");
+    lua_getfield(L, -1, "randomseed");
+    lua_pushnumber(L, static_cast<lua_Number>(seed));
+    if (lua_pcall(L, 1, 0, 0) != 0) {
+        lua_pop(L, 1);  // error message
+    }
+    lua_pop(L, 1);  // math
+}
+
+long long devtools::f2f::lua_memory_kb() {
+    auto L = lua::get_main_state();
+    if (L == nullptr) {
+        return -1;
+    }
+    return lua_gc(L, LUA_GCCOUNT, 0);
+}
diff --git a/src/devtools/f2f_perf.cpp b/src/devtools/f2f_perf.cpp
new file mode 100644
index 00000000..c9203f52
--- /dev/null
+++ b/src/devtools/f2f_perf.cpp
@@ -0,0 +1,421 @@
+#include "f2f_perf.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include "coders/json.hpp"
+#include "data/dv.hpp"
+#include "f2f.hpp"
+#include "f2f_text.hpp"
+#include "util/stringutil.hpp"
+
+namespace devtools::f2f::perf {
+    std::atomic<bool> enabled_flag {false};
+}
+
+using namespace devtools::f2f;
+using namespace devtools::f2f::perf;
+
+namespace {
+    using Clock = std::chrono::steady_clock;
+    const Clock::time_point epoch = Clock::now();
+
+    const char* const PHASE_NAMES[PHASES_COUNT] = {
+        "frame", "input", "app_tick", "update", "world_update", "chunks_load",
+        "light_chunk", "light_block", "render", "render_world", "mesh_upload",
+        "mesh_sync", "mesh_worker", "hud", "gui", "post_update", "present",
+        "lua"};
+
+    constexpr int TID_MAIN = 1;
+    constexpr int TID_LUA = 2;
+    constexpr int TID_F2F = 3;
+    constexpr int TID_WORKER0 = 10;
+
+    struct Acc {
+        int64_t sum_us = 0;
+        int64_t calls = 0;
+        int64_t items = 0;
+    };
+
+    struct Event {
+        std::string name;
+        char ph;
+        char scope;  // instant events: 'g' global, 't' thread, 0 none
+        int tid;
+        int64_t ts;
+        int64_t dur;
+        std::string args;  // JSON object text or empty
+    };
+
+    std::mutex mutex;
+    std::thread::id main_thread;
+    thread_local int lua_depth = 0;
+
+    bool trace_on = false;
+    size_t max_events = 500000;
+    int64_t lua_min_us = 20;
+    size_t dropped = 0;
+    std::vector<Event> events;
+    std::unordered_map<std::thread::id, int> worker_tids;
+
+    Acc total[PHASES_COUNT];
+    Acc frame_acc[PHASES_COUNT];
+    Acc idle[PHASES_COUNT];
+    std::vector<float> per_frame[PHASES_COUNT];
+    bool in_frame = false;
+    int64_t frame_t0 = 0;
+    int64_t frames = 0;
+    int64_t cur_frame = 0;
+    int64_t cur_tick = 0;
+    double cur_time = 0.0;
+    int64_t start_us = 0;
+    int64_t stop_us = -1;
+
+    bool is_main() {
+        return std::this_thread::get_id() == main_thread;
+    }
+
+    // mutex held
+    int thread_tid() {
+        auto id = std::this_thread::get_id();
+        if (id == main_thread) return TID_MAIN;
+        auto found = worker_tids.find(id);
+        if (found != worker_tids.end()) return found->second;
+        int tid = TID_WORKER0 + static_cast<int>(worker_tids.size());
+        worker_tids[id] = tid;
+        return tid;
+    }
+
+    // mutex held
+    void push_event(Event&& event) {
+        if (!trace_on) return;
+        if (events.size() >= max_events) {
+            dropped++;
+            return;
+        }
+        events.push_back(std::move(event));
+    }
+
+    // mutex held
+    void account(Phase phase, int64_t dur, int items, bool main) {
+        bool outside = main && !in_frame;
+        Acc& acc = outside ? idle[phase] : frame_acc[phase];
+        acc.sum_us += dur;
+        acc.calls++;
+        acc.items += items;
+        Acc& all = total[phase];
+        all.sum_us += dur;
+        all.calls++;
+        all.items += items;
+    }
+
+    void reset() {
+        for (int i = 0; i < PHASES_COUNT; i++) {
+            total[i] = frame_acc[i] = idle[i] = Acc {};
+            per_frame[i].clear();
+        }
+        events.clear();
+        events.shrink_to_fit();
+        worker_tids.clear();
+        dropped = 0;
+        frames = 0;
+        in_frame = false;
+        stop_us = -1;
+    }
+
+    double percentile(std::vector<float> sorted, double p) {
+        if (sorted.empty()) return 0.0;
+        std::sort(sorted.begin(), sorted.end());
+        size_t rank = static_cast<size_t>(
+            std::ceil(p * static_cast<double>(sorted.size()))
+        );
+        rank = std::clamp<size_t>(rank, 1, sorted.size());
+        return sorted[rank - 1];
+    }
+
+    double round3(double v) {
+        return std::round(v * 1000.0) / 1000.0;
+    }
+
+    // mutex held
+    dv::value summary() {
+        dv::value phases = dv::object();
+        for (int i = 0; i < PHASES_COUNT; i++) {
+            const auto& acc = total[i];
+            const auto& pf = per_frame[i];
+            double max = 0.0;
+            double sum_frames = 0.0;
+            int64_t nonzero = 0;
+            for (float v : pf) {
+                max = std::max<double>(max, v);
+                sum_frames += v;
+                if (v > 0.0f) nonzero++;
+            }
+            phases[PHASE_NAMES[i]] = dv::object({
+                {"count", acc.calls},
+                {"items", acc.items},
+                {"sum_ms", round3(acc.sum_us / 1000.0)},
+                {"idle_ms", round3(idle[i].sum_us / 1000.0)},
+                {"frames", nonzero},
+                {"mean_ms", round3(pf.empty() ? 0.0 : sum_frames / pf.size())},
+                {"p50_ms", round3(percentile(pf, 0.50))},
+                {"p99_ms", round3(percentile(pf, 0.99))},
+                {"max_ms", round3(max)},
+            });
+        }
+        int64_t end = stop_us >= 0 ? stop_us : now_us();
+        double frame_sum = total[FRAME].sum_us / 1000.0;
+        return dv::object({
+            {"enabled", enabled()},
+            {"trace", trace_on},
+            {"frames", frames},
+            {"wall_ms", round3((end - start_us) / 1000.0)},
+            {"frame_ms_mean", round3(frames ? frame_sum / frames : 0.0)},
+            {"events", static_cast<int64_t>(events.size())},
+            {"dropped", static_cast<int64_t>(dropped)},
+            {"lua_min_us", lua_min_us},
+            {"clock", std::string("steady_clock, us since process start")},
+            {"phases", phases},
+        });
+    }
+
+    std::string escape_name(const std::string& name) {
+        return util::escape(text::sanitize(name), false);
+    }
+
+    void write_event(std::ostream& out, const Event& e) {
+        out << "{\"name\":" << escape_name(e.name) << ",\"ph\":\"" << e.ph
+            << "\",\"pid\":1,\"tid\":" << e.tid << ",\"ts\":" << e.ts;
+        if (e.ph == 'X') out << ",\"dur\":" << e.dur;
+        if (e.scope) out << ",\"s\":\"" << e.scope << "\"";
+        if (!e.args.empty()) out << ",\"args\":" << e.args;
+        out << "}";
+    }
+
+    void write_meta(std::ostream& out, int tid, const std::string& name) {
+        out << "{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":" << tid
+            << ",\"args\":{\"name\":" << escape_name(name) << "}},\n";
+        out << "{\"name\":\"thread_sort_index\",\"ph\":\"M\",\"pid\":1,\"tid\":"
+            << tid << ",\"args\":{\"sort_index\":" << tid << "}},\n";
+    }
+
+    // mutex held
+    dv::value dump(const std::string& path) {
+        if (events.empty()) {
+            throw std::runtime_error(
+                "no trace events (start with perf {start:true, trace:true})"
+            );
+        }
+#ifdef _WIN32
+        std::ofstream out(std::filesystem::u8path(path), std::ios::binary);
+#else
+        std::ofstream out(path, std::ios::binary);
+#endif
+        if (!out) {
+            throw std::runtime_error("could not open " + path);
+        }
+        out << "{\"displayTimeUnit\":\"ms\",\"otherData\":{\"producer\":"
+               "\"VoxelCore F2F perf\",\"clock\":\"steady_clock us\"},\n"
+               "\"traceEvents\":[\n";
+        out << "{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":1,\"tid\":1,"
+               "\"args\":{\"name\":\"VoxelCoreF2F\"}},\n";
+        write_meta(out, TID_MAIN, "main");
+        write_meta(out, TID_LUA, "lua (f2f.trace_event)");
+        write_meta(out, TID_F2F, "f2f commands");
+        std::vector<std::pair<int, int>> workers;
+        for (const auto& [_, tid] : worker_tids) workers.push_back({tid, tid});
+        std::sort(workers.begin(), workers.end());
+        for (const auto& [tid, _] : workers) {
+            write_meta(out, tid, "worker " + std::to_string(tid - TID_WORKER0));
+        }
+        for (size_t i = 0; i < events.size(); i++) {
+            write_event(out, events[i]);
+            out << (i + 1 < events.size() ? ",\n" : "\n");
+        }
+        out << "]}\n";
+        auto bytes = static_cast<int64_t>(out.tellp());
+        out.close();
+        if (!out) {
+            throw std::runtime_error("could not write " + path);
+        }
+        return dv::object({
+            {"path", path},
+            {"bytes", bytes},
+            {"events", static_cast<int64_t>(events.size())},
+        });
+    }
+}
+
+int64_t perf::now_us() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               Clock::now() - epoch
+    ).count();
+}
+
+void perf::set_main_thread() {
+    std::lock_guard lock(mutex);
+    main_thread = std::this_thread::get_id();
+}
+
+bool perf::tracing() {
+    return enabled() && trace_on;
+}
+
+void perf::record(Phase phase, int64_t t0, int64_t t1, int items) {
+    std::lock_guard lock(mutex);
+    if (!enabled()) return;
+    bool main = is_main();
+    int64_t dur = t1 - t0;
+    account(phase, dur, items, main);
+    if (trace_on && (phase != LUA || dur >= lua_min_us)) {
+        std::string args;
+        if (items) args = "{\"items\":" + std::to_string(items) + "}";
+        push_event({PHASE_NAMES[phase], 'X', 0, thread_tid(), t0, dur, std::move(args)});
+    }
+}
+
+void perf::add_items(Phase phase, int items) {
+    std::lock_guard lock(mutex);
+    if (!enabled()) return;
+    bool outside = is_main() && !in_frame;
+    (outside ? idle[phase] : frame_acc[phase]).items += items;
+    total[phase].items += items;
+}
+
+perf::LuaScope::LuaScope() {
+    if (!enabled()) return;
+    counted = true;
+    if (lua_depth++ == 0 && is_main()) {
+        t0 = now_us();
+    }
+}
+
+perf::LuaScope::~LuaScope() {
+    if (!counted) return;
+    lua_depth--;
+    if (t0 >= 0) {
+        record(LUA, t0, now_us(), 0);
+    }
+}
+
+void perf::frame_begin(int64_t frame, int64_t tick, double time) {
+    if (!enabled()) return;
+    std::lock_guard lock(mutex);
+    in_frame = true;
+    frame_t0 = now_us();
+    cur_frame = frame;
+    cur_tick = tick;
+    cur_time = time;
+}
+
+void perf::frame_end() {
+    if (!enabled()) return;
+    int64_t lua_kb = lua_memory_kb();
+    int64_t t1 = now_us();
+    std::lock_guard lock(mutex);
+    if (!in_frame) return;
+    int64_t dur = t1 - frame_t0;
+    account(FRAME, dur, 0, true);
+    for (int i = 0; i < PHASES_COUNT; i++) {
+        per_frame[i].push_back(static_cast<float>(frame_acc[i].sum_us / 1000.0));
+    }
+    if (trace_on) {
+        char buf[160];
+        std::snprintf(
+            buf, sizeof(buf), "{\"frame\":%lld,\"tick\":%lld,\"time\":%.6f}",
+            static_cast<long long>(cur_frame), static_cast<long long>(cur_tick),
+            cur_time
+        );
+        push_event({"frame", 'X', 0, TID_MAIN, frame_t0, dur, buf});
+        std::snprintf(
+            buf, sizeof(buf),
+            "{\"chunks_load\":%lld,\"light_chunk\":%lld,\"mesh_upload\":%lld,"
+            "\"mesh_worker\":%lld}",
+            static_cast<long long>(frame_acc[CHUNKS_LOAD].items),
+            static_cast<long long>(frame_acc[LIGHT_CHUNK].items),
+            static_cast<long long>(frame_acc[MESH_UPLOAD].items),
+            static_cast<long long>(frame_acc[MESH_WORKER].items)
+        );
+        push_event({"chunks per frame", 'C', 0, TID_MAIN, t1, 0, buf});
+        if (lua_kb >= 0) {
+            push_event({"lua_mem_kb", 'C', 0, TID_MAIN, t1, 0,
+                        "{\"kb\":" + std::to_string(lua_kb) + "}"});
+        }
+    }
+    for (auto& acc : frame_acc) acc = Acc {};
+    frames++;
+    in_frame = false;
+}
+
+void perf::command(
+    const std::string& cmd, int64_t t0, int64_t t1, const dv::value& id
+) {
+    if (!enabled()) return;
+    std::lock_guard lock(mutex);
+    if (!trace_on) return;
+    std::string args;
+    if (id.isInteger()) {
+        args = "{\"id\":" + std::to_string(id.asInteger()) + "}";
+    }
+    if (cmd == "step") {
+        push_event({"step", 'i', 'g', TID_F2F, t0, 0, args});
+    }
+    push_event({"f2f:" + cmd, 'X', 0, TID_F2F, t0, t1 - t0, std::move(args)});
+}
+
+bool perf::lua_event(
+    const std::string& name, char ph, const dv::value& args, int64_t ts,
+    int64_t dur
+) {
+    if (!tracing()) return false;
+    if (ph != 'B' && ph != 'E' && ph != 'X' && ph != 'i' && ph != 'C') {
+        return false;
+    }
+    std::string json;
+    if (args.isObject()) {
+        json = text::stringify_response(args);
+    }
+    std::lock_guard lock(mutex);
+    push_event({name, ph, static_cast<char>(ph == 'i' ? 't' : 0), TID_LUA, ts, dur, std::move(json)});
+    return true;
+}
+
+dv::value perf::command_perf(const dv::value& args) {
+    std::lock_guard lock(mutex);
+    dv::value result = dv::object();
+    if (args.has("start") && args["start"].asBoolean()) {
+        enabled_flag.store(false);
+        reset();
+        trace_on = args.has("trace") && args["trace"].asBoolean();
+        if (args.has("max_events")) {
+            max_events = static_cast<size_t>(
+                std::max<int64_t>(0, args["max_events"].asInteger())
+            );
+        }
+        if (args.has("lua_min_us")) {
+            lua_min_us = args["lua_min_us"].asInteger();
+        }
+        if (trace_on) events.reserve(std::min<size_t>(max_events, 65536));
+        start_us = now_us();
+        enabled_flag.store(true);
+        result["started"] = true;
+    }
+    if (args.has("stop") && args["stop"].asBoolean()) {
+        if (enabled()) stop_us = now_us();
+        enabled_flag.store(false);
+        result["stopped"] = true;
+    }
+    if (args.has("dump")) {
+        result["dump"] = dump(args["dump"].asString());
+    }
+    result["summary"] = summary();
+    return result;
+}
diff --git a/src/devtools/f2f_perf.hpp b/src/devtools/f2f_perf.hpp
new file mode 100644
index 00000000..dbecbfd2
--- /dev/null
+++ b/src/devtools/f2f_perf.hpp
@@ -0,0 +1,118 @@
+#pragma once
+
+// F2F `perf`: per-frame phase timings of the engine, measured on the engine
+// clock (std::chrono::steady_clock), for test builds (agents/F2F.md §2,
+// research/DETERMINISM.md §4). Off by default: every probe is one relaxed
+// atomic load and a branch. Enabled only by the F2F command
+//   perf {start:true, trace:bool} / {stop:true} / {dump:"path.json"} / {}
+// Summary: count, items, sum, per-frame p50/p99/max per phase. Trace:
+// Chrome trace-event JSON ({"traceEvents":[...]}) for ui.perfetto.dev.
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace dv {
+    class value;
+}
+
+namespace devtools::f2f::perf {
+    enum Phase : int {
+        FRAME,         // one F2F step pass: input .. present
+        INPUT,         // Input::pollEvents (F2F queue)
+        APP_TICK,      // Engine::applicationTick (project setup coroutine)
+        UPDATE,        // Engine::updateFrontend (assets, gui act, screen update)
+        WORLD_UPDATE,  // LevelScreen::update (player, LevelController, hud)
+        CHUNKS_LOAD,   // ChunksController::update (items: chunks created)
+        LIGHT_CHUNK,   // ChunksController::buildLights (items: chunks lit)
+        LIGHT_BLOCK,   // Lighting::onBlockSet (items: blocks)
+        RENDER,        // Engine::renderFrame
+        RENDER_WORLD,  // WorldRenderer::update + renderFrame
+        MESH_UPLOAD,   // ChunksRenderer::update: worker results -> GPU meshes (items)
+        MESH_SYNC,     // ChunksRenderer::render, important chunk built on main thread
+        MESH_WORKER,   // chunk mesh build in worker threads (items: chunks)
+        HUD,           // Hud::draw
+        GUI,           // gui::GUI::draw
+        POST_UPDATE,   // Engine::postUpdate
+        PRESENT,       // F2F present: blit to window + glfwSwapBuffers
+        LUA,           // top-level Lua calls on the main thread (lua::call*)
+        PHASES_COUNT
+    };
+
+    extern std::atomic<bool> enabled_flag;
+
+    inline bool enabled() {
+        return enabled_flag.load(std::memory_order_relaxed);
+    }
+
+    /// @brief engine clock, microseconds since the perf epoch (process start
+    /// of the perf module). Lua: f2f.now_us()
+    int64_t now_us();
+
+    /// @brief record a measured interval (thread-safe)
+    void record(Phase phase, int64_t t0, int64_t t1, int items);
+
+    /// @brief add items (counted things) to a phase without timing
+    void add_items(Phase phase, int items);
+
+    class Scope {
+        Phase phase;
+        int64_t t0 = -1;
+    public:
+        int items = 0;
+
+        explicit Scope(Phase phase) : phase(phase) {
+            if (enabled()) {
+                t0 = now_us();
+            }
+        }
+        ~Scope() {
+            if (t0 >= 0) {
+                record(phase, t0, now_us(), items);
+            }
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+    };
+
+    /// @brief top-level Lua call on the main thread (nested calls and other
+    /// threads are not timed separately)
+    class LuaScope {
+        int64_t t0 = -1;
+        bool counted = false;
+    public:
+        LuaScope();
+        ~LuaScope();
+        LuaScope(const LuaScope&) = delete;
+        LuaScope& operator=(const LuaScope&) = delete;
+    };
+
+    // ------------------------------------------------- F2F side (f2f.cpp)
+
+    void set_main_thread();
+    void frame_begin(int64_t frame, int64_t tick, double time);
+    void frame_end();
+
+    /// @brief F2F command boundary on the "f2f" track (X event + instant)
+    void command(const std::string& cmd, int64_t t0, int64_t t1, const dv::value& id);
+
+    /// @brief protocol command `perf`
+    dv::value command_perf(const dv::value& args);
+
+    /// @brief Lua event f2f.trace_event(name, ph, args, ts, dur) on the "lua"
+    /// track; false when tracing is off or the phase is unknown
+    bool lua_event(
+        const std::string& name, char ph, const dv::value& args,
+        int64_t ts, int64_t dur
+    );
+
+    bool tracing();
+}
+
+#define F2F_PERF_CONCAT2(a, b) a##b
+#define F2F_PERF_CONCAT(a, b) F2F_PERF_CONCAT2(a, b)
+/// RAII timer of an engine phase, e.g. F2F_PERF_SCOPE(RENDER_WORLD);
+#define F2F_PERF_SCOPE(phase)                                          \
+    ::devtools::f2f::perf::Scope F2F_PERF_CONCAT(f2f_perf_scope_, __LINE__)( \
+        ::devtools::f2f::perf::phase                                   \
+    )
diff --git a/src/devtools/f2f_render.cpp b/src/devtools/f2f_render.cpp
new file mode 100644
index 00000000..08ec1699
--- /dev/null
+++ b/src/devtools/f2f_render.cpp
@@ -0,0 +1,290 @@
+#include "f2f_render.hpp"
+
+#include <GL/glew.h>
+
+#include <algorithm>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "data/dv.hpp"
+#include "debug/Logger.hpp"
+#include "graphics/core/Shader.hpp"
+#include "graphics/ui/elements/Container.hpp"
+#include "graphics/ui/elements/UINode.hpp"
+
+static debug::Logger logger("f2f-render");
+
+namespace devtools::f2f::render {
+    bool gates_active = false;
+    bool layers[LAYERS_COUNT] = {
+        true, true, true, true, true, true, true,
+        true, true, true, true, true, true};
+    std::atomic<bool> fullbright_flag {false};
+}
+
+using namespace devtools::f2f;
+
+namespace {
+    const char* const NAMES[render::LAYERS_COUNT] = {
+        "sky", "clouds", "terrain", "water", "entities", "particles",
+        "weather", "selection", "hand", "hud", "gui", "fog", "lighting"};
+
+    int clear_rgb[3] {0, 0, 0};
+    std::atomic<int> epoch {0};
+    bool remesh = false;
+    std::vector<std::weak_ptr<gui::UINode>> hud_nodes;
+
+    GLuint bg_program = 0;
+    GLuint bg_vao = 0;
+    GLuint bg_vbo = 0;
+    GLint bg_color_loc = -1;
+
+    GLuint compile(GLenum type, const char* src) {
+        GLuint id = glCreateShader(type);
+        glShaderSource(id, 1, &src, nullptr);
+        glCompileShader(id);
+        GLint ok = 0;
+        glGetShaderiv(id, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[1024];
+            glGetShaderInfoLog(id, sizeof(log), nullptr, log);
+            throw std::runtime_error(std::string("f2f background shader: ") + log);
+        }
+        return id;
+    }
+
+    void init_background() {
+        const char* vs =
+            "#version 330 core\n"
+            "layout (location = 0) in vec2 v_position;\n"
+            "void main() { gl_Position = vec4(v_position, 1.0 - 1e-6, 1.0); }\n";
+        // same outputs as background.glslf (color, position, normal)
+        const char* fs =
+            "#version 330 core\n"
+            "layout (location = 0) out vec4 f_color;\n"
+            "layout (location = 1) out vec4 f_position;\n"
+            "layout (location = 2) out vec4 f_normal;\n"
+            "uniform vec3 u_color;\n"
+            "void main() {\n"
+            "  f_color = vec4(u_color, 1.0);\n"
+            "  f_position = vec4(0.0, 0.0, -1e6, 1.0);\n"
+            "  f_normal = vec4(0.0, 0.0, 1.0, 1.0);\n"
+            "}\n";
+        GLuint v = compile(GL_VERTEX_SHADER, vs);
+        GLuint f = compile(GL_FRAGMENT_SHADER, fs);
+        bg_program = glCreateProgram();
+        glAttachShader(bg_program, v);
+        glAttachShader(bg_program, f);
+        glLinkProgram(bg_program);
+        glDeleteShader(v);
+        glDeleteShader(f);
+        bg_color_loc = glGetUniformLocation(bg_program, "u_color");
+
+        const float tri[] = {-1.0f, -1.0f, 3.0f, -1.0f, -1.0f, 3.0f};
+        GLint prev_vao = 0, prev_vbo = 0;
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prev_vao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prev_vbo);
+        glGenVertexArrays(1, &bg_vao);
+        glGenBuffers(1, &bg_vbo);
+        glBindVertexArray(bg_vao);
+        glBindBuffer(GL_ARRAY_BUFFER, bg_vbo);
+        glBufferData(GL_ARRAY_BUFFER, sizeof(tri), tri, GL_STATIC_DRAW);
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), nullptr);
+        glEnableVertexAttribArray(0);
+        glBindVertexArray(prev_vao);
+        glBindBuffer(GL_ARRAY_BUFFER, prev_vbo);
+    }
+}
+
+render::Mask::Mask(Layer layer) {
+    if (on(layer)) {
+        return;
+    }
+    masked = true;
+    GLboolean c[4];
+    GLboolean d;
+    glGetBooleanv(GL_COLOR_WRITEMASK, c);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &d);
+    for (int i = 0; i < 4; i++) color[i] = c[i];
+    depth = d;
+    glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+    glDepthMask(GL_FALSE);
+}
+
+render::Mask::~Mask() {
+    if (masked) {
+        glColorMask(color[0], color[1], color[2], color[3]);
+        glDepthMask(depth);
+    }
+}
+
+int render::mesh_epoch() {
+    return epoch.load();
+}
+
+bool render::take_remesh() {
+    bool flag = remesh;
+    remesh = false;
+    return flag;
+}
+
+float render::fog_factor(float factor) {
+    return on(FOG) ? factor : 0.0f;
+}
+
+void render::world_uniforms(Shader& shader) {
+    if (!gates_active) {
+        return;
+    }
+    if (!layers[FOG]) {
+        // calc_fog(): pow(depth*0, curve) = 0; min(.., opacity 0) = 0
+        shader.uniform1f("u_fogFactor", 0.0f);
+        shader.uniform1f("u_weatherFogOpacity", 0.0f);
+        shader.uniform1f("u_weatherFogDencity", 0.0f);
+        shader.uniform1f("u_weatherFogCurve", 1.0f);
+    }
+    if (!layers[LIGHTING]) {
+        // vertex light is 1.0 (see BlocksRenderer/MainBatch); torch light
+        // would push pow(1 + t*color, gamma) above 1
+        shader.uniform3f("u_torchlightColor", 0.0f, 0.0f, 0.0f);
+    }
+}
+
+void render::draw_clear_background() {
+    if (bg_program == 0) {
+        init_background();
+    }
+    GLint prev_program = 0, prev_vao = 0;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prev_program);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prev_vao);
+    GLboolean blend = glIsEnabled(GL_BLEND);
+    glDisable(GL_BLEND);
+    glUseProgram(bg_program);
+    glUniform3f(
+        bg_color_loc,
+        clear_rgb[0] / 255.0f,
+        clear_rgb[1] / 255.0f,
+        clear_rgb[2] / 255.0f
+    );
+    glBindVertexArray(bg_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindVertexArray(prev_vao);
+    glUseProgram(prev_program);
+    if (blend) {
+        glEnable(GL_BLEND);
+    }
+}
+
+void render::screen_clear() {
+    if (on(SKY)) {
+        return;
+    }
+    GLfloat prev[4];
+    glGetFloatv(GL_COLOR_CLEAR_VALUE, prev);
+    glClearColor(
+        clear_rgb[0] / 255.0f, clear_rgb[1] / 255.0f, clear_rgb[2] / 255.0f, 1.0f
+    );
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    glClearColor(prev[0], prev[1], prev[2], prev[3]);
+}
+
+void render::mark_hud_node(const std::shared_ptr<gui::UINode>& node) {
+    if (!gates_active || node == nullptr) {
+        return;
+    }
+    hud_nodes.erase(
+        std::remove_if(
+            hud_nodes.begin(),
+            hud_nodes.end(),
+            [](const auto& weak) { return weak.expired(); }
+        ),
+        hud_nodes.end()
+    );
+    hud_nodes.push_back(node);
+}
+
+bool render::skip_ui_node(const gui::Container& parent, const gui::UINode& node) {
+    if (!gates_active || (layers[HUD] && layers[GUI])) {
+        return false;
+    }
+    for (const auto& weak : hud_nodes) {
+        auto locked = weak.lock();
+        if (locked.get() == &node) {
+            return !layers[HUD];
+        }
+    }
+    // top-level nodes of the main GUI root (menu pages, pause overlay,
+    // inventory, tooltip, Lua-added nodes) = gui layer
+    if (parent.getParent() == nullptr && parent.getId() == "root") {
+        return !layers[GUI];
+    }
+    return false;
+}
+
+dv::value render::names() {
+    auto list = dv::list();
+    for (auto name : NAMES) {
+        list.add(std::string(name));
+    }
+    return list;
+}
+
+dv::value render::state() {
+    auto map = dv::object();
+    for (int i = 0; i < LAYERS_COUNT; i++) {
+        map[NAMES[i]] = layers[i];
+    }
+    auto clear = dv::list();
+    for (int i = 0; i < 3; i++) {
+        clear.add(static_cast<int64_t>(clear_rgb[i]));
+    }
+    return dv::object({{"layers", map}, {"clear", clear}});
+}
+
+dv::value render::command(const dv::value& args) {
+    bool lighting_before = layers[LIGHTING];
+    if (args.has("all")) {
+        std::fill(layers, layers + LAYERS_COUNT, args["all"].asBoolean());
+    }
+    if (args.has("layers")) {
+        for (const auto& [key, value] : args["layers"].asObject()) {
+            const std::string name = key;
+            auto found = std::find_if(
+                std::begin(NAMES), std::end(NAMES),
+                [&name](const char* n) { return name == n; }
+            );
+            if (found == std::end(NAMES)) {
+                std::string known;
+                for (auto n : NAMES) {
+                    known += (known.empty() ? "" : ", ") + std::string(n);
+                }
+                throw std::runtime_error(
+                    "render: unknown layer " + name + " (known: " + known + ")"
+                );
+            }
+            layers[found - std::begin(NAMES)] = value.asBoolean();
+        }
+    }
+    if (args.has("clear")) {
+        const auto& clear = args["clear"];
+        if (clear.size() < 3) {
+            throw std::runtime_error("render: clear must be [r,g,b] 0..255");
+        }
+        for (int i = 0; i < 3; i++) {
+            int v = static_cast<int>(clear[i].asInteger());
+            clear_rgb[i] = std::clamp(v, 0, 255);
+        }
+    }
+    bool rebuilt = false;
+    if (lighting_before != layers[LIGHTING]) {
+        fullbright_flag.store(!layers[LIGHTING]);
+        epoch++;
+        remesh = true;
+        rebuilt = true;
+    }
+    auto result = state();
+    result["rebuilt"] = rebuilt;
+    logger.info() << "render: lighting " << layers[LIGHTING] << ", sky " << layers[SKY];
+    return result;
+}
diff --git a/src/devtools/f2f_render.hpp b/src/devtools/f2f_render.hpp
