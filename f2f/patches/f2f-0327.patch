new file mode 100644
index 00000000..af0b6e4c
--- /dev/null
+++ b/src/devtools/f2f_text.cpp
@@ -0,0 +1,225 @@
+#include "f2f_text.hpp"
+
+#include <cstdio>
+#include <exception>
+
+#include "coders/json.hpp"
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <GLFW/glfw3.h>
+#define GLFW_EXPOSE_NATIVE_WIN32
+#include <GLFW/glfw3native.h>
+#endif
+
+#include "f2f.hpp"
+
+using namespace devtools::f2f;
+
+// Win32 window isolation lives here because this is the only F2F unit that
+// includes windows.h (see README "Touched engine files").
+void devtools::f2f::isolate_native_window(void* glfwWindow, bool show) {
+#ifdef _WIN32
+    HWND hwnd = glfwGetWin32Window(static_cast<GLFWwindow*>(glfwWindow));
+    if (hwnd == nullptr) {
+        return;
+    }
+    // WS_EX_NOACTIVATE: a click on the window (or on its taskbar button)
+    // does not make it the foreground window, so the user's keyboard focus
+    // never moves to the engine. WS_EX_APPWINDOW keeps the taskbar button.
+    LONG_PTR ex = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
+    SetWindowLongPtrW(hwnd, GWL_EXSTYLE, ex | WS_EX_NOACTIVATE | WS_EX_APPWINDOW);
+    SetWindowPos(
+        hwnd, nullptr, 0, 0, 0, 0,
+        SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+            SWP_FRAMECHANGED
+    );
+    if (show) {
+        // not glfwShowWindow: on the first show GLFW 3.4 uses the process
+        // STARTUPINFO.wShowWindow (SW_SHOWNORMAL activates when the parent
+        // passes it); SW_SHOWNOACTIVATE never activates
+        ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+    }
+#else
+    if (show) {
+        glfwShowWindow(static_cast<GLFWwindow*>(glfwWindow));
+    }
+#endif
+}
+
+namespace {
+    /// @return length of the valid UTF-8 sequence at s[pos], 0 if invalid;
+    /// cp receives the code point
+    size_t valid_seq(std::string_view s, size_t pos, uint32_t& cp) {
+        auto b = [&](size_t i) { return static_cast<unsigned char>(s[i]); };
+        unsigned char c = b(pos);
+        size_t n;
+        uint32_t min;
+        if (c < 0x80) { cp = c; return 1; }
+        else if (c >= 0xC2 && c <= 0xDF) { n = 2; cp = c & 0x1F; min = 0x80; }
+        else if (c >= 0xE0 && c <= 0xEF) { n = 3; cp = c & 0x0F; min = 0x800; }
+        else if (c >= 0xF0 && c <= 0xF4) { n = 4; cp = c & 0x07; min = 0x10000; }
+        else return 0;
+        if (pos + n > s.size()) return 0;
+        for (size_t i = 1; i < n; i++) {
+            unsigned char cc = b(pos + i);
+            if ((cc & 0xC0) != 0x80) return 0;
+            cp = (cp << 6) | (cc & 0x3F);
+        }
+        if (cp < min || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {
+            return 0;
+        }
+        return n;
+    }
+
+    void append_hex(std::string& out, unsigned char c) {
+        char buf[5];
+        std::snprintf(buf, sizeof(buf), "\\x%02X", c);
+        out += buf;
+    }
+
+    void append_escaped(std::string& out, std::string_view run) {
+        for (unsigned char c : run) append_hex(out, c);
+    }
+
+    /// invalid run -> UTF-8 via the ANSI code page; false if not possible
+    bool append_ansi(std::string& out, std::string_view run) {
+#ifdef _WIN32
+        UINT acp = text::ansi_code_page();
+        if (acp == 0 || run.size() > 1 << 20) return false;
+        int wn = MultiByteToWideChar(
+            acp, MB_ERR_INVALID_CHARS, run.data(), static_cast<int>(run.size()),
+            nullptr, 0
+        );
+        if (wn <= 0) return false;
+        std::wstring w(static_cast<size_t>(wn), L'\0');
+        MultiByteToWideChar(
+            acp, MB_ERR_INVALID_CHARS, run.data(), static_cast<int>(run.size()),
+            w.data(), wn
+        );
+        int un = WideCharToMultiByte(
+            CP_UTF8, 0, w.data(), wn, nullptr, 0, nullptr, nullptr
+        );
+        if (un <= 0) return false;
+        std::string u(static_cast<size_t>(un), '\0');
+        WideCharToMultiByte(CP_UTF8, 0, w.data(), wn, u.data(), un, nullptr, nullptr);
+        // the transcoded text may itself contain control characters
+        out += text::sanitize(u);
+        return true;
+#else
+        (void)out;
+        (void)run;
+        return false;
+#endif
+    }
+}
+
+unsigned text::ansi_code_page() noexcept {
+#ifdef _WIN32
+    UINT acp = GetACP();
+    return acp == CP_UTF8 ? 0 : acp;
+#else
+    return 0;
+#endif
+}
+
+bool text::is_valid_utf8(std::string_view s) noexcept {
+    uint32_t cp;
+    for (size_t pos = 0; pos < s.size();) {
+        size_t n = valid_seq(s, pos, cp);
+        if (n == 0) return false;
+        pos += n;
+    }
+    return true;
+}
+
+std::string text::sanitize(std::string_view s, bool bmp_only) noexcept {
+    try {
+        std::string out;
+        out.reserve(s.size());
+        size_t pos = 0;
+        while (pos < s.size()) {
+            uint32_t cp = 0;
+            size_t n = valid_seq(s, pos, cp);
+            if (n == 0) {
+                size_t end = pos + 1;
+                while (end < s.size() && valid_seq(s, end, cp) == 0) end++;
+                std::string_view run = s.substr(pos, end - pos);
+                if (!append_ansi(out, run)) {
+                    append_escaped(out, run);
+                }
+                pos = end;
+                continue;
+            }
+            if (n == 1 && cp < 0x20 && cp != '\n' && cp != '\r' && cp != '\t') {
+                append_hex(out, static_cast<unsigned char>(cp));
+            } else if (n == 1 && cp == 0x7F) {
+                append_hex(out, 0x7F);
+            } else if (bmp_only && cp > 0xFFFF) {
+                out += "\xEF\xBF\xBD";  // U+FFFD
+            } else {
+                out.append(s.data() + pos, n);
+            }
+            pos += n;
+        }
+        return out;
+    } catch (...) {
+        // allocation failure: keep only printable ASCII
+        std::string out;
+        try {
+            for (unsigned char c : s) out += (c >= 0x20 && c < 0x7F) ? char(c) : '?';
+        } catch (...) {
+        }
+        return out;
+    }
+}
+
+dv::value text::sanitize_value(const dv::value& value) {
+    switch (value.getType()) {
+        case dv::value_type::string:
+            return sanitize(value.asString());
+        case dv::value_type::list: {
+            auto list = dv::list();
+            for (const auto& item : value) {
+                list.add(sanitize_value(item));
+            }
+            return list;
+        }
+        case dv::value_type::object: {
+            auto object = dv::object();
+            for (const auto& [key, item] : value.asObject()) {
+                object[sanitize(key, true)] = sanitize_value(item);
+            }
+            return object;
+        }
+        default:
+            return value;
+    }
+}
+
+std::string text::stringify_response(const dv::value& response) noexcept {
+    try {
+        return json::stringify(sanitize_value(response), false);
+    } catch (const std::exception& err) {
+        try {
+            dv::value fallback = dv::object();
+            if (response.isObject() && response.has("id")) {
+                const auto& id = response["id"];
+                if (id.isInteger() || id.isNumber()) fallback["id"] = id;
+            }
+            fallback["ok"] = false;
+            fallback["error"] = "response-serialization-failed: " +
+                                sanitize(std::string_view(err.what()));
+            return json::stringify(fallback, false);
+        } catch (...) {
+        }
+    } catch (...) {
+    }
+    return "{\"ok\":false,\"error\":\"response-serialization-failed\"}";
+}
diff --git a/src/devtools/f2f_text.hpp b/src/devtools/f2f_text.hpp
new file mode 100644
index 00000000..bfde8c12
--- /dev/null
+++ b/src/devtools/f2f_text.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+// F2F: text sanitising for protocol responses (agents/F2F.md, LESSONS
+// "utf8 decode error"). Strings that reach a JSON response may come from the
+// OS (std::filesystem_error::what() in the ANSI code page, cp1251 on a
+// Russian Windows), from Lua or from GL drivers. json::stringify throws on
+// invalid UTF-8, and it did so from the catch block of the command loop,
+// killing the process. Everything placed into a response goes through here.
+
+#include <string>
+#include <string_view>
+
+#include "data/dv.hpp"
+
+namespace devtools::f2f::text {
+    /// @brief Valid UTF-8 passes unchanged. Each maximal run of bytes that is
+    /// not valid UTF-8 is transcoded from the ANSI code page (Windows, when it
+    /// is not UTF-8) or replaced by "\xNN" text. Control characters other
+    /// than \n \r \t become "\xNN" text (util::escape writes them as invalid
+    /// JSON). With `bmp_only`, code points above U+FFFF become U+FFFD (object
+    /// keys are escaped as \uXXXX, which cannot hold them). Never throws.
+    std::string sanitize(std::string_view s, bool bmp_only = false) noexcept;
+
+    /// @brief true if `s` is strict UTF-8 (no overlongs, surrogates, > U+10FFFF)
+    bool is_valid_utf8(std::string_view s) noexcept;
+
+    /// @brief deep copy with every string (and object key) sanitised
+    dv::value sanitize_value(const dv::value& value);
+
+    /// @brief JSON line for a response; never throws: if serialisation fails
+    /// the result is an ASCII error response
+    std::string stringify_response(const dv::value& response) noexcept;
+
+    /// @brief the ANSI code page used for transcoding (0 = none / not Windows)
+    unsigned ansi_code_page() noexcept;
+}
