+    // ------------------------------------------------------------- input
+
+    Keycode key_from_name(const std::string& name) {
+        static const std::map<std::string, std::string> aliases {
+            // LWJGL 2 names -> engine names
+            {"lshift", "left-shift"}, {"rshift", "right-shift"},
+            {"lcontrol", "left-ctrl"}, {"rcontrol", "right-ctrl"},
+            {"lctrl", "left-ctrl"}, {"rctrl", "right-ctrl"},
+            {"lmenu", "left-alt"}, {"rmenu", "right-alt"},
+            {"lalt", "left-alt"}, {"ralt", "right-alt"},
+            {"return", "enter"}, {"back", "backspace"},
+            {"grave", "grave-accent"}, {"capital", "caps-lock"},
+            {"prior", "page-up"}, {"next", "page-down"},
+            {"lwin", "left-super"}, {"rwin", "right-super"},
+        };
+        static const std::map<std::string, Keycode> extra {
+            {"minus", Keycode::MINUS}, {"equals", Keycode::EQUAL},
+            {"equal", Keycode::EQUAL}, {"comma", Keycode::COMMA},
+            {"period", Keycode::PERIOD}, {"slash", Keycode::SLASH},
+            {"semicolon", Keycode::SEMICOLON},
+            {"apostrophe", Keycode::APOSTROPHE},
+            {"lbracket", Keycode::LEFT_BRACKET},
+            {"rbracket", Keycode::RIGHT_BRACKET},
+            {"backslash", Keycode::BACKSLASH},
+        };
+        std::string lower = name;
+        std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        auto alias = aliases.find(lower);
+        if (alias != aliases.end()) {
+            lower = alias->second;
+        }
+        auto code = input_util::keycode_from(lower);
+        if (code != Keycode::UNKNOWN) {
+            return code;
+        }
+        auto found = extra.find(lower);
+        if (found != extra.end()) {
+            return found->second;
+        }
+        return Keycode::UNKNOWN;
+    }
+
+    std::vector<uint32_t> utf8_codepoints(const std::string& s) {
+        std::vector<uint32_t> out;
+        for (size_t i = 0; i < s.size();) {
+            unsigned char c = s[i];
+            uint32_t cp;
+            int n;
+            if (c < 0x80) { cp = c; n = 1; }
+            else if ((c >> 5) == 6) { cp = c & 0x1F; n = 2; }
+            else if ((c >> 4) == 14) { cp = c & 0x0F; n = 3; }
+            else { cp = c & 0x07; n = 4; }
+            for (int j = 1; j < n && i + j < s.size(); j++) {
+                cp = (cp << 6) | (s[i + j] & 0x3F);
+            }
+            out.push_back(cp);
+            i += n;
+        }
+        return out;
+    }
+
+    dv::value cmd_input(const dv::value& args) {
+        using devtools::f2f::EventType;
+        using devtools::f2f::InputEvent;
+        size_t queued = 0;
+        if (args.has("keys")) {
+            // dv objects are unordered: apply in sorted key order
+            std::map<std::string, bool> sorted;
+            for (const auto& [name, value] : args["keys"].asObject()) {
+                sorted[name] = value.asBoolean();
+            }
+            for (const auto& [name, pressed] : sorted) {
+                Keycode code = key_from_name(name);
+                if (code == Keycode::UNKNOWN) {
+                    throw std::runtime_error("unknown-key: " + name);
+                }
+                int icode = static_cast<int>(code);
+                if (state.keys[icode] != pressed) {
+                    state.keys[icode] = pressed;
+                    state.events.push_back(
+                        {EventType::KEY, icode, pressed, 0.0, 0.0}
+                    );
+                    queued++;
+                }
+            }
+        }
+        if (args.has("mouse")) {
+            const auto& mouse = args["mouse"];
+            double x = state.cursorX;
+            double y = state.cursorY;
+            if (mouse.has("x")) x = mouse["x"].asNumber();
+            if (mouse.has("y")) y = mouse["y"].asNumber();
+            if (mouse.has("dx")) x += mouse["dx"].asNumber();
+            if (mouse.has("dy")) y += mouse["dy"].asNumber();
+            bool moved = mouse.has("x") || mouse.has("y") ||
+                         mouse.has("dx") || mouse.has("dy");
+            if (moved) {
+                state.cursorX = x;
+                state.cursorY = y;
+                state.events.push_back({EventType::CURSOR, 0, false, x, y});
+                queued++;
+            }
+            if (mouse.has("buttons")) {
+                const auto& buttons = mouse["buttons"];
+                for (size_t i = 0; i < buttons.size() && i < 8; i++) {
+                    bool pressed = buttons[i].asBoolean();
+                    if (state.buttons[i] != pressed) {
+                        state.buttons[i] = pressed;
+                        state.events.push_back(
+                            {EventType::MOUSE_BUTTON, static_cast<int>(i),
+                             pressed, 0.0, 0.0}
+                        );
+                        queued++;
+                    }
+                }
+            }
+            if (mouse.has("wheel")) {
+                int wheel = static_cast<int>(mouse["wheel"].asInteger());
+                if (wheel != 0) {
+                    state.events.push_back(
+                        {EventType::SCROLL, wheel, false, 0.0, 0.0}
+                    );
+                    queued++;
+                }
+            }
+        }
+        if (args.has("chars")) {
+            for (uint32_t cp : utf8_codepoints(args["chars"].asString())) {
+                state.events.push_back(
+                    {EventType::CHAR, static_cast<int>(cp), false, 0.0, 0.0}
+                );
+                queued++;
+            }
+        }
+        return dv::object({{"queued", static_cast<int64_t>(queued)}});
+    }
