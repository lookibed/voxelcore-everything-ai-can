@@ -0,0 +1,97 @@
+#pragma once
+
+// F2F render layers (agents/F2F.md §7): command
+//   render {layers:{sky:bool, ...}, clear:[r,g,b] (0..255), all:bool}
+// Every gate returns true when F2F mode is off, so without --f2f the engine
+// renders exactly as before. Read at the render sites (WorldRenderer, Hud,
+// gui::Container, BlocksRenderer, MainBatch, MenuScreen).
+
+#include <atomic>
+#include <memory>
+
+class Shader;
+
+namespace dv {
+    class value;
+}
+
+namespace gui {
+    class UINode;
+    class Container;
+}
+
+namespace devtools::f2f::render {
+    enum Layer {
+        SKY, CLOUDS, TERRAIN, WATER, ENTITIES, PARTICLES, WEATHER,
+        SELECTION, HAND, HUD, GUI,
+        FOG,      // modifier: fog on world layers
+        LIGHTING, // modifier: baked light / face shading; off = full bright
+        LAYERS_COUNT
+    };
+
+    extern bool gates_active;
+    extern bool layers[LAYERS_COUNT];
+    /// @brief lighting is off (read from chunk mesh worker threads too)
+    extern std::atomic<bool> fullbright_flag;
+
+    inline bool on(Layer layer) {
+        return !gates_active || layers[layer];
+    }
+
+    /// @brief RAII: while the layer is off, draws inside the scope write
+    /// neither colour nor depth (glColorMask/glDepthMask), but the code still
+    /// runs, so render-time side effects (skeleton matrices, particle expiry,
+    /// batch queues) stay exactly as with the layer on
+    class Mask {
+        bool masked = false;
+        unsigned char color[4] {};
+        unsigned char depth = 0;
+    public:
+        explicit Mask(Layer layer);
+        ~Mask();
+        Mask(const Mask&) = delete;
+        Mask& operator=(const Mask&) = delete;
+    };
+
+    inline bool fullbright() {
+        return fullbright_flag.load(std::memory_order_relaxed);
+    }
+
+    /// @brief incremented on every lighting toggle; chunk meshes built under
+    /// another epoch are discarded
+    int mesh_epoch();
+
+    /// @brief true once after lighting was toggled: all chunk meshes must be
+    /// rebuilt (WorldRenderer calls ChunksRenderer::clear)
+    bool take_remesh();
+
+    /// @brief fog factor passed to world shaders / clouds (0 when fog is off)
+    float fog_factor(float factor);
+
+    /// @brief override world shader uniforms (fog, torch light) when the
+    /// modifiers are off; called at the end of setupWorldShader
+    void world_uniforms(Shader& shader);
+
+    /// @brief sky layer off: fill the far-plane pixels with the clear colour
+    /// (same depth as the sky background plane)
+    void draw_clear_background();
+
+    /// @brief sky layer off: re-clear the whole frame with the clear colour
+    /// (screens without a world: menu)
+    void screen_clear();
+
+    /// @brief register a HUD node (hotbar, debug panel, in-game HUD documents)
+    void mark_hud_node(const std::shared_ptr<gui::UINode>& node);
+
+    /// @brief should `node` (child of `parent`) be skipped by the UI draw
+    bool skip_ui_node(const gui::Container& parent, const gui::UINode& node);
+
+    /// @brief protocol command `render`
+    dv::value command(const dv::value& args);
+
+    /// @brief current state {layers:{...}, clear:[r,g,b]}
+    dv::value state();
+
+    /// @brief supported layer names
+    dv::value names();
+}
diff --git a/src/devtools/f2f_socket.cpp b/src/devtools/f2f_socket.cpp
new file mode 100644
index 00000000..08c99efa
--- /dev/null
+++ b/src/devtools/f2f_socket.cpp
@@ -0,0 +1,141 @@
+#include "f2f_socket.hpp"
+
+#ifdef _WIN32
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#pragma comment(lib, "Ws2_32.lib")
+using socket_t = SOCKET;
+static inline int close_socket(socket_t s) { return closesocket(s); }
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using socket_t = int;
+static inline int close_socket(socket_t s) { return ::close(s); }
+#endif
+
+using namespace devtools::f2f;
+
+LineServer::~LineServer() {
+    close();
+}
+
+std::string LineServer::open(int port) {
+#ifdef _WIN32
+    WSADATA wsa;
+    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+        return "WSAStartup failed";
+    }
+#endif
+    socket_t s = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == static_cast<socket_t>(-1)) {
+        return "socket() failed";
+    }
+    int yes = 1;
+#ifndef _WIN32
+    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&yes, sizeof(yes));
+#endif
+    sockaddr_in addr {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(static_cast<unsigned short>(port));
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (::bind(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+        close_socket(s);
+        return "bind 127.0.0.1:" + std::to_string(port) + " failed";
+    }
+    if (::listen(s, 1) != 0) {
+        close_socket(s);
+        return "listen() failed";
+    }
+    (void)yes;
+    listenSocket = static_cast<long long>(s);
+    return "";
+}
+
+void LineServer::dropClient() {
+    if (clientSocket != -1) {
+        close_socket(static_cast<socket_t>(clientSocket));
+        clientSocket = -1;
+    }
+    buffer.clear();
+}
+
+void LineServer::close() {
+    dropClient();
+    if (listenSocket != -1) {
+        close_socket(static_cast<socket_t>(listenSocket));
+        listenSocket = -1;
+    }
+}
+
+std::vector<std::string> LineServer::poll(int timeoutMs) {
+    std::vector<std::string> lines;
+    if (listenSocket == -1) {
+        return lines;
+    }
+    socket_t s = static_cast<socket_t>(
+        clientSocket != -1 ? clientSocket : listenSocket
+    );
+    fd_set set;
+    FD_ZERO(&set);
+    FD_SET(s, &set);
+    timeval tv {};
+    tv.tv_sec = timeoutMs / 1000;
+    tv.tv_usec = (timeoutMs % 1000) * 1000;
+    int n = ::select(static_cast<int>(s) + 1, &set, nullptr, nullptr, &tv);
+    if (n <= 0) {
+        return lines;
+    }
+    if (clientSocket == -1) {
+        socket_t c = ::accept(s, nullptr, nullptr);
+        if (c != static_cast<socket_t>(-1)) {
+            int one = 1;
+            setsockopt(c, IPPROTO_TCP, TCP_NODELAY, (const char*)&one, sizeof(one));
+            clientSocket = static_cast<long long>(c);
+        }
+        return lines;
+    }
+    char chunk[4096];
+    int received = ::recv(s, chunk, sizeof(chunk), 0);
+    if (received <= 0) {
+        dropClient();
+        return lines;
+    }
+    buffer.append(chunk, received);
+    size_t pos;
+    while ((pos = buffer.find('\n')) != std::string::npos) {
+        std::string line = buffer.substr(0, pos);
+        buffer.erase(0, pos + 1);
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+        }
+        if (!line.empty()) {
+            lines.push_back(std::move(line));
+        }
+    }
+    return lines;
+}
+
+void LineServer::send(const std::string& line) {
+    if (clientSocket == -1) {
+        return;
+    }
+    std::string data = line + "\n";
+    socket_t c = static_cast<socket_t>(clientSocket);
+    size_t sent = 0;
+    while (sent < data.size()) {
+        int n = ::send(
+            c, data.data() + sent, static_cast<int>(data.size() - sent), 0
+        );
+        if (n <= 0) {
+            dropClient();
+            return;
+        }
+        sent += n;
+    }
+}
diff --git a/src/devtools/f2f_socket.hpp b/src/devtools/f2f_socket.hpp
new file mode 100644
index 00000000..6c7ed4bf
--- /dev/null
+++ b/src/devtools/f2f_socket.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+// Minimal line-based TCP server for F2F mode (127.0.0.1 only, one client).
+
+#include <string>
+#include <vector>
+
+namespace devtools::f2f {
+    class LineServer {
+    public:
+        LineServer() = default;
+        ~LineServer();
+        LineServer(const LineServer&) = delete;
+
+        /// @return error message or empty string on success
+        std::string open(int port);
+        void close();
+
+        /// @brief Wait up to timeoutMs for data; returns complete lines
+        std::vector<std::string> poll(int timeoutMs);
+
+        /// @brief Send one line (newline appended)
+        void send(const std::string& line);
+    private:
+        long long listenSocket = -1;
+        long long clientSocket = -1;
+        std::string buffer;
+
+        void dropClient();
+    };
+}
