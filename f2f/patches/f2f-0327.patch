+    dv::value build_info() {
+        dv::value flags = dv::object({
+#if defined(__clang__)
+            {"compiler", std::string("clang ") + __clang_version__},
+#elif defined(__GNUC__)
+            {"compiler", std::string("gcc ") + __VERSION__},
+#elif defined(_MSC_VER)
+            {"compiler", std::string("msvc ") + std::to_string(_MSC_VER)},
+#endif
+            {"cplusplus", static_cast<int64_t>(__cplusplus)},
+#ifdef NDEBUG
+            {"ndebug", true},
+#else
+            {"ndebug", false},
+#endif
+#ifdef __OPTIMIZE__
+            {"optimize", true},
+#else
+            {"optimize", false},
+#endif
+#if defined(__MINGW64__)
+            {"target", std::string("x86_64-w64-mingw32")},
+#elif defined(_WIN64)
+            {"target", std::string("win64")},
+#else
+            {"target", std::string("other")},
+#endif
+#if defined(_LIBCPP_VERSION)
+            {"stdlib", std::string("libc++ ") + std::to_string(_LIBCPP_VERSION)},
+#elif defined(__GLIBCXX__)
+            {"stdlib", std::string("libstdc++ ") + std::to_string(__GLIBCXX__)},
+#endif
+            {"recipe", std::string(F2F_BUILD_RECIPE)},
+        });
+        return dv::object({
+            {"commit", std::string(F2F_BUILD_COMMIT)},
+            {"dirty", std::string(F2F_BUILD_DIRTY)},
+            {"flags", flags},
+        });
+    }
