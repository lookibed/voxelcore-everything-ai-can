# --- монолитный каталог: на диске всё, в git — только среда (код, документы)
/engines/v*/
/builds/
/packs/*.zip
/packs/*/.cache/
/projects/*/external/**/*.exe
/projects/*/external/**/target/
/projects/*/tools/**/gateway_tokens.json
/projects/*/tools/**/gateway_bans.json
*.wad
*.pak
*.epk
*.bak
__pycache__/

# --- паки и проекты — отдельные репозитории, в этот репо не публикуются (на диске остаются)
/packs/*
!/packs/README.md
/projects/*
!/projects/_template/
# vc — проект самой среды (MCP vc_start, тесты движка); его legacy-сценарии паков — контент
!/projects/vc/
/projects/vc/scenarios_legacy/
/projects/vc/reference/
# описания паков и проектов — локальные
/catalog/
/docs/PACKS.md
