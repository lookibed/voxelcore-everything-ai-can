# machine.toml — корни ЭТОЙ машины (файл в .gitignore). Обычно его создаёт install/bootstrap.ps1 (или bootstrap.sh из
# WSL): корни внутри репозитория, python_win — найденный Python 3.13. Вручную: скопировать в machine.toml и
# поправить пути; проверка — `lab doctor`.
# Строки в одинарных кавычках — литералы TOML (обратные слэши Windows без экранирования).
# Ключи и смысл — vclab/machine.py (KEYS); что делать, если чего-то нет, — install/doctor.md.

engines_root = 'C:\VoxelCore\voxelcore-everything-ai-can\engines'   # стоковые релизы: <engines_root>\<install_dir реестра>, для v0327 — engines\v0327\VoxelCore.exe
builds_root = 'C:\VoxelCore\voxelcore-everything-ai-can\builds'     # тестовые сборки F2F: <builds_root>\<f2f_exe реестра>, для v0327 — builds\0327\VoxelCoreF2F-0327-767234c5.exe
work_root = 'C:\VoxelCore\voxelcore-everything-ai-can\work'         # данные демона (<work_root>\lab), прогоны, изолированные демоны
python_win = 'C:\Python313\python.exe'     # Windows-Python 3.13: pywin32 psutil fastapi uvicorn numpy Pillow jinja2 pytest
python_wsl   = '/usr/bin/python3'            # WSL-Python (MCP voxelcore, тонкие клиенты)
msys2        = 'C:\msys64'                   # только для сборки F2F (f2f/build); bootstrap закомментирует, если его нет
wsl_mount    = '/mnt'                        # мост WSL <-> Windows: диски Windows в WSL
powershell   = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'

# Перекрытия раскладки по версиям (engines/registry.toml): root, res, stock, vctest, f2f — когда движок уже лежит в
# другом месте (не качать второй раз), или для легаси-версий (legacy = true) машины-источника
# [engines.v0327]
# root = 'E:\VoxelCore\voxelcore-0.32.7_win64'
# [engines.v031]
# root = 'D:\old\voxelcore-0.31'
# f2f  = 'D:\builds\VoxelCoreF2F.exe'
# Для `lab f2f build <id>` (f2f/README.md): worktree ветки F2F и каталог vcpkg нужного коммита
# f2f_src = 'D:\src\voxelcore-0327'
# vcpkg   = 'D:\src\vcpkg-0327'
