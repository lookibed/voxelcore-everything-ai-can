<?xml version="1.0" encoding="UTF-8"?>
<!-- Страница меню wasmrt: хост программы с графикой 'canvas' (постэффектов в меню нет).
     Логика — modules/app.lua (attach). -->
<container
    pos="0, 0"
    size-func="function() local size = gui.get_viewport() return size[1], size[2] end"
    interactive="true"
    color="#000000FF">
    <button id="back_btn" pos="8, 8" onclick="leave()">@Back to Main Menu</button>
</container>
