<?xml version="1.0" encoding="UTF-8"?>
<!-- Страница чата пака smollm_gpu: модель считается на GPU (фреймы GUI в текстуру + ui.glslf пака), один токен = один
     кадр движка. Логика — modules/chat.lua (M.run в app-скрипте), страница только показывает состояние и отдаёт ввод.
     Раскладка — как у content/smollm (smollm_chat.xml) + кнопка «Демо» (три эталонных промпта, страница smollm_gpu). -->
<container id="root" color="#101418FF" size-func="unpack(gui.get_viewport())" interactive="true">
    <panel id="toolbar" orientation="horizontal" interval="6" padding="6,6,6,6" color="#1C2430FF"
           size-func="gui.get_viewport()[1],44">
        <button id="back_btn" size="100,32" color="#5050ff60" hover-color="#5050ffa0" onclick="leave()">Назад</button>
        <label id="title" size="250,32" valign="center" color="#E6EAF0">Ru-Small-Instruct: чат (GPU)</label>
        <button id="stop_btn" size="80,32" color="#A0303080" hover-color="#C04040C0" onclick="stop_click()">Стоп</button>
        <button id="reset_btn" size="110,32" color="#30A05080" hover-color="#40C060C0" onclick="reset_click()">Очистить</button>
        <checkbox id="remember" size="170,32" checked="false" consumer="remember_click">помнить диалог</checkbox>
        <button id="demo_btn" size="80,32" color="#80608080" hover-color="#A080A0C0" onclick="demo_click()">Демо</button>
    </panel>
    <label id="status" pos="8,50" size-func="gui.get_viewport()[1]-16,20" color="#9FB4D0">запуск...</label>
    <container id="log_box" pos="8,74" size-func="gui.get_viewport()[1]-16, gui.get_viewport()[2]-126" color="#000000A0">
        <textbox id="log" color="0" autoresize="true" margin="0" editable="false" multiline="true" text-wrap="true"
                 size-func="-1,40" gravity="bottom-left" padding="6"></textbox>
    </container>
    <textbox id="prompt" position-func="8, gui.get_viewport()[2]-44" size-func="gui.get_viewport()[1]-134,36"
             color="#000000A0" padding="8,8,8,4" hint="Сообщение модели (Enter - отправить)" consumer="on_submit"></textbox>
    <button id="send_btn" position-func="gui.get_viewport()[1]-118, gui.get_viewport()[2]-44" size="110,36"
            color="#5050ff80" hover-color="#5050ffc0" onclick="send_click()">Отправить</button>
</container>
