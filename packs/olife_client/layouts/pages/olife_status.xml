        </container>
        <label id="st_prog" pos="50,302" size="540,18" color="#C8D0E0"></label>
        <label id="st_file" pos="50,322" size="540,18" color="#90A0B0"></label>
        <container id="st_errbox" pos="10,344" size="600,62" color="#50201880" visible="false">
            <label id="st_err1" pos="6,4" size="588,18" color="#FF9080"></label>
            <label id="st_err2" pos="6,22" size="588,18" color="#FF9080"></label>
