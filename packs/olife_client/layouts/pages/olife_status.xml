<!-- Olife status screen (UX B, 16.10, olife_menu): every step of the login (ticket -> gateway -> Welcome -> pack manifest ->
     downloads with files/bytes and the current pack/file -> sha256 -> replica world -> first chunks) and any error with its
     protocol/HTTP code and the reason; Повторить / Назад. Menu page (menu.page = "olife_status"); the same ids are in
     layouts/olife_status.xml (HUD element in the game: packs on the fly, world restarting, reconnect). Only draws
     olife_client:status (olife_client:status_view); buttons -> olife_client:menu requests. -->
<container id="root" color="#060A16" size-func="unpack(gui.get_viewport())">
    <container id="st_panel" position-func="math.floor(gui.get_viewport()[1]/2-310),math.max(4,math.floor(gui.get_viewport()[2]/2-228))" size="620,456" color="#141830F0">
        <label id="st_title" pos="14,10" size="592,24" color="#FFD080">Olife</label>
        <label id="st_target" pos="14,36" size="592,18" color="#90A0B0"></label>
        <label id="st_ph1" pos="24,62" size="580,20" color="#7882A0"></label>
        <label id="st_ph2" pos="24,84" size="580,20" color="#7882A0"></label>
        <label id="st_ph3" pos="24,106" size="580,20" color="#7882A0"></label>
        <label id="st_ph4" pos="24,128" size="580,20" color="#7882A0"></label>
        <label id="st_ph5" pos="24,150" size="580,20" color="#7882A0"></label>
        <label id="st_ph6" pos="24,172" size="580,20" color="#7882A0"></label>
        <label id="st_ph7" pos="24,194" size="580,20" color="#7882A0"></label>
        <label id="st_ph8" pos="24,216" size="580,20" color="#7882A0"></label>
        <label id="st_ph9" pos="24,238" size="580,20" color="#7882A0"></label>
        <label id="st_ph10" pos="24,260" size="580,20" color="#7882A0"></label>
        <container id="st_bar_bg" pos="50,286" size="520,12" color="#FFFFFF20">
