{
 "name": "eag_rain",
 "description": "Eaglercraft: новый мир (сид 1234567890) с читами -> /toggledownfall -> дождь/снег (renderRainSnow, StrictMath.log из nextGaussian)",
 "steps": [
  {
   "tool": "eag_start",
   "args": {},
   "expect": {
    "screen": "GuiScreenEditProfile|GuiMainMenu"
   },
   "checkpoint": "profile",
   "limit": 300,
   "slow_s": 60
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Done"
   },
   "skip_if": {
    "screen": "GuiMainMenu"
   },
   "expect": {
    "screen": "GuiMainMenu"
   },
   "checkpoint": "menu",
   "limit": 20
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Singleplayer"
   },
   "expect": {
    "screen": "GuiSelectWorld"
   },
   "checkpoint": "worlds",
   "limit": 90,
   "slow_s": 30
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Create New World"
   },
   "expect": {
    "screen": "GuiScreenCreateWorldSelection"
   },
   "checkpoint": "create_select",
   "limit": 20
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Create New World"
   },
   "expect": {
    "screen": "GuiCreateWorld"
   },
   "checkpoint": "create",
   "limit": 20
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "More World Options..."
   },
   "expect": {
    "screen": "GuiCreateWorld",
    "text": "Seed for the World Generator"
   },
   "checkpoint": "options",
   "limit": 20
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Allow Cheats"
   },
   "expect": {
    "screen": "GuiCreateWorld",
    "text": "Allow Cheats: ON"
   },
   "checkpoint": "cheats",
   "limit": 20
  },
  {
   "tool": "eag_mouse",
   "args": {
    "x": 426,
    "y": 140
   },
   "expect": {
    "screen": "GuiCreateWorld"
   },
   "limit": 10
  },
  {
   "tool": "vc_input",
   "args": {
    "sequence": "text:1234567890"
   },
   "expect": {
    "screen": "GuiCreateWorld",
    "text": "^1234567890_?$"
   },
   "checkpoint": "seed",
   "limit": 20
  },
  {
   "tool": "eag_click",
   "args": {
    "target": "Create New World"
   },
   "expect": {
    "screen": "ingame",
    "world": true
   },
   "checkpoint": "entered",
   "limit": 300,
   "slow_s": 60
  },
  {
   "tool": "eag_wait",
   "args": {
    "screen": "ingame",
    "fps": 1,
    "fps_drop": true,
    "fps_lines": 2,
    "drop_grace": 40
   },
   "expect": {
    "screen": "ingame",
    "world": true
   },
   "checkpoint": "world",
   "limit": 400,
   "slow_s": 240
  },
  {
   "tool": "eag_key",
   "args": {
    "key": "t"
   },
   "expect": {
    "screen": "GuiChat"
   },
   "limit": 20
  },
  {
   "tool": "eag_type",
   "args": {
    "text": "/toggledownfall"
   },
   "limit": 10
  },
  {
   "tool": "eag_key",
   "args": {
    "key": "enter"
   },
   "expect": {
    "screen": "ingame"
   },
   "checkpoint": "downfall",
   "limit": 20
  },
  {
   "tool": "eag_wait",
   "args": {
    "fps": 1,
    "fps_lines": 3,
    "timeout": 60
   },
   "expect": {
    "screen": "ingame",
    "world": true
   },
   "checkpoint": "rain",
   "limit": 90
  }
 ]
}