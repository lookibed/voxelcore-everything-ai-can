{
 "name": "eag_saved_world",
 "description": "Eaglercraft: старт -> Singleplayer -> первый мир списка -> Play Selected World -> конец пересчёта света",
 "steps": [
  {"tool": "eag_start", "args": {}, "expect": {"screen": "GuiScreenEditProfile|GuiMainMenu"},
   "checkpoint": "profile", "limit": 300, "slow_s": 60},
  {"tool": "eag_click", "args": {"target": "Done"}, "skip_if": {"screen": "GuiMainMenu"},
   "expect": {"screen": "GuiMainMenu"}, "checkpoint": "menu", "limit": 20},
  {"tool": "eag_click", "args": {"target": "Singleplayer"},
   "expect": {"screen": "GuiSelectWorld"}, "checkpoint": "worlds", "limit": 90, "slow_s": 30},
  {"tool": "eag_mouse", "args": {"x": 426, "y": 135},
   "expect": {"screen": "GuiSelectWorld", "enabled": "Play Selected World"}, "checkpoint": "selected", "limit": 10},
  {"tool": "eag_click", "args": {"target": "Play Selected World"},
   "expect": {"screen": "ingame", "world": true}, "checkpoint": "entered", "limit": 300, "slow_s": 60},
  {"tool": "eag_wait", "args": {"screen": "ingame", "fps": 1, "fps_drop": true, "fps_lines": 2, "drop_grace": 10},
   "expect": {"screen": "ingame", "world": true}, "checkpoint": "world", "limit": 400, "slow_s": 240}
 ]
}
