{
 "setup": {
  "session": {
   "clients": 2,
   "client_kind": "bot",
   "sandbox": true,
   "scripted": 2,
   "sandbox_proto": "bin"
  }
 },
 "steps": [
  {
   "cmd": "olife_run",
   "args": {
    "seconds": 2
   }
  },
  {
   "cmd": "olife_spawn",
   "args": {
    "spawns": [
     [
      "typical",
      1,
      10,
      50
     ]
    ],
    "wait_entities": 500,
    "timeout": 30
   }
  },
  {
   "cmd": "olife_run",
   "args": {
    "seconds": 20
   }
  },
  {
   "cmd": "olife_sandbox_wire",
   "args": {
    "proto": "bin"
   }
  },
  {
   "cmd": "olife_sandbox_check",
   "args": {
    "warmup_ticks": 60,
    "min_rows": 250,
    "min_entities": 500,
    "min_owners": 50,
    "controls": [
     1,
     25,
     50
    ],
    "max_bad_control_rows": 5
   }
  },
  {
   "cmd": "olife_consistency",
   "args": {
    "max_divergences": 0,
    "min_ticks": 200
   }
  },
  {
   "cmd": "olife_status",
   "args": {
    "strict": false
   }
  },
  {
   "cmd": "olife_metrics"
  }
 ],
 "description": "Wave 4b: world <-> REAL olife-sandboxd over the BINARY contract (sandbox.yaml, magic OS; transport by the first byte on the same port). 500 typical entities (50 owners x 10) + 2 orbit + 2 bots: control owners updated every TickResult after warm-up, replication consistent, bytes per TickInput/TickResult on the wire (olife_sandbox_wire). Twin with JSON lines: olife_sandbox_binary_json."
}