{
 "description": "Wave 5p (olife_w5p) profile variant: olife_sandbox_load (500 typical, 2 bots) — jit=tuned, stock GC. World --opts prof=1,jitlog=1,jit=tuned,gc=auto. Per-tick CSV world_prof.csv + JIT trace summary (olife_w5p.py); NOT a clean perf claim.",
 "setup": {
  "session": {
   "clients": 2,
   "client_kind": "bot",
   "sandbox": true,
   "scripted": 0,
   "world_opts": "prof=1,jitlog=1,jit=tuned,gc=auto"
  }
 },
 "steps": [
  {
   "cmd": "olife_run",
   "args": {
    "seconds": 2
   }
  },
  {
   "cmd": "olife_spawn",
   "args": {
    "spawns": [
     [
      "typical",
      1,
      10,
      50
     ]
    ],
    "wait_entities": 500,
    "timeout": 30
   }
  },
  {
   "cmd": "olife_run",
   "args": {
    "seconds": 2
   }
  },
  {
   "cmd": "olife_prof_mark"
  },
  {
   "cmd": "olife_run",
   "args": {
    "seconds": 25
   }
  },
  {
   "cmd": "olife_prof",
   "args": {
    "warmup_ticks": 0
   }
  },
  {
   "cmd": "olife_sandbox_check",
   "args": {
    "warmup_ticks": 60,
    "min_rows": 300,
    "min_entities": 500,
    "min_owners": 50,
    "controls": [
     1,
     25,
     50
    ],
    "max_bad_control_rows": 5
   }
  },
  {
   "cmd": "olife_status",
   "args": {
    "strict": false
   }
  },
  {
   "cmd": "olife_metrics"
  }
 ]
}